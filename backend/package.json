{
  "name": "arshi-enterprises-backend",
  "version": "1.0.0",
  "description": "Node.js authentication backend with Express, MongoDB, bcrypt, and JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "npm --prefix ../frontend run dev",
    "client": "npm --prefix ../frontend run dev",
    "client:build": "npm --prefix ../frontend run build",
    "seed": "node src/utils/seedTestData.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.4"
  }
}