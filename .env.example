NODE_ENV=development
PORT=4000

# MongoDB (local for dev, Atlas URI for production)
MONGODB_URI=mongodb://127.0.0.1:27017/authdb
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/authdb?retryWrites=true&w=majority

# Security
JWT_SECRET=replace-with-a-secure-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Default Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS (frontend URL)
FRONTEND_URL=http://localhost:5173
